# Paste the Atlas connection string here when you have it. Leave it blank and the server keeps
# its data in server/.data/db.json instead, so you can build and demo before the URI arrives.
MONGO_URI=

# Signs the login tokens. Generate a fresh one per environment -- never reuse the development
# secret in production, and never commit either:
#
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# Changing it signs every phone and tablet out at once, which is how you revoke a lost device.
JWT_SECRET=change-me-to-something-long-and-random

# The PIN the shop staff type to get in. Pick something the shop will actually remember, and
# change it again whenever someone who knew it stops working there. The server refuses to start
# quietly on the default: it prints a warning every boot until this is changed.
AUTH_PIN=1234

PORT=4000

# Comma-separated origins allowed to call the API in development.
CORS_ORIGIN=http://localhost:5173
